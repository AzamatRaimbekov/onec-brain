#Область СлужебныеПроцедурыИФункции

// Записывает объект в транзакции с журналированием ошибки.
Процедура ЗаписатьОбъект(Объект) Экспорт
	НачатьТранзакцию();
	Попытка
		Объект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Пример.Запись'"), УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
